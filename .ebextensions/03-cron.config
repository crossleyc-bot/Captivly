# CloudWatch Events rules to trigger cron jobs via HTTP
# These call the /api/cron endpoint with the appropriate job param
#
# To set up manually in AWS Console:
# 1. Create a CloudWatch Events rule with a cron schedule
# 2. Target: HTTP endpoint (your EB URL + /api/cron?job=...)
# 3. Add Authorization header with INTERNAL_API_SECRET
#
# Alternative: Use cron.yaml for Elastic Beanstalk worker tier

files:
  "/etc/cron.d/captivly-scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Sequence scheduler - every hour
      0 * * * * root curl -s -H "Authorization: Bearer ${INTERNAL_API_SECRET}" http://localhost:8080/api/cron?job=sequence-scheduler >> /var/log/captivly-cron.log 2>&1
      # Dead letter retry - every 15 minutes
      */15 * * * * root curl -s -H "Authorization: Bearer ${INTERNAL_API_SECRET}" http://localhost:8080/api/cron?job=dead-letter-retry >> /var/log/captivly-cron.log 2>&1
      # Report cards - 1st of every month at 8am UTC
      0 8 1 * * root curl -s -H "Authorization: Bearer ${INTERNAL_API_SECRET}" http://localhost:8080/api/cron?job=report-cards >> /var/log/captivly-cron.log 2>&1
      # Usage reset - 1st of every month at midnight UTC
      0 0 1 * * root curl -s -H "Authorization: Bearer ${INTERNAL_API_SECRET}" http://localhost:8080/api/cron?job=usage-reset >> /var/log/captivly-cron.log 2>&1

  "/etc/logrotate.d/captivly-cron":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/captivly-cron.log {
        daily
        rotate 7
        compress
        missingok
        notifempty
      }
